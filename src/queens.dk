import core.builtins.*;
import src.constants.*;
import src.helpers.*;
import src.puzzles.*;

class Solution {
    n: i32;
    board: List[i32];
    occupied: List[i32];
    occupiedColors: List[i32];

    fun getColor(x: i32, y: i32) -> i32 = {
        return board.at(x * n + y);
    }

    fun initialize(_n: i32, _board: ref List[i32]) = {
        board = copy _board;
        n = _n;

        resize(&occupiedColors, n);
        resize(&occupied, n * n);
    }

    fun clear(x: i32, y: i32) = {
        occupied.at(x * n + y) = 0;
    }

    fun placeQueen(x: i32, y: i32) = {
        if (occupiedColors.at(getColor(x, y)) != 0) error("Placing queen on of the same color twice");

        occupiedColors.at(getColor(x, y)) = 1;

        var z = 0;
        while (z < n)
        {
            placeCross(z, y);
            z += 1;
        }

        z = 0;
        while (z < n)
        {
            placeCross(x, z);
            z += 1;
        }

        # Diagonal
        placeCross(x + 1, y + 1);
        placeCross(x + 1, y - 1);
        placeCross(x - 1, y + 1);
        placeCross(x - 1, y - 1);

        occupied.at(x * n + y) = 2;
    }

    fun rowHasQueen(x: i32) -> bool = {
        var y: i32 = 0;
        while(y < n)
        {
            if (hasQueen(x, y))
            {
                # print(f"Row checking queen at {x} {y}\n");
                return true;
            }
            y += 1;
        }
        # print("queen not found\n");
        return false;
    }

    fun columnHasQueen(y: i32) -> bool = {
        var x: i32 = 0;
        while(x < n)
        {
            if (hasQueen(x, y))
            {
                # print(f"Column checking queen at {x} {y}\n");
                return true;
            }
            x += 1;
        }
        # print("queen not found\n");
        return false;
    }

    fun placeCross(x: i32, y: i32) = {
        if (0 <= x < n and 0 <= y < n)
            if (occupied.at(x * n + y) == 0)
                occupied.at(x * n + y) = -2;
    }

    fun canPlace(x: i32, y: i32) -> bool = {
        return occupied.at(x * n + y) == 0 and occupiedColors.at(getColor(x, y)) == 0;
    }

    fun hasQueen(x: i32, y: i32) -> bool = {
        return occupied.at(x * n + y) > 0;
    }
    
    fun isSolved() -> bool = {
        var i = 0;
        while(i < n)
        {
            if(occupiedColors.at(i) == 0) return false;
            i += 1;
        }
        return true;
    }

    fun verticalSeparator(x: i32, y: i32) -> str = {
        if (0 < y < n)
        {
            if(getColor(x, y - 1) == getColor(x, y))
                return " ";
        }
        return "|";
    }

    fun isNew(x: i32, y: i32) -> bool = {
        var cell: i32 = occupied.at(x * n + y);
        if (cell == 2 or cell == -2)
        {
            return true;
        }
        return false;
    }

    fun refresh(x: i32, y: i32) -> bool = {
        var cell: i32 = occupied.at(x * n + y);
        if (cell == 2)
        {
            occupied.at(x * n + y) = 1;
            return true;
        }
        else if (cell == -2)
        {
            occupied.at(x * n + y) = -1;
            return true;
        }
        return false;
    }

    fun toString() -> String = {
        var result: String = "".toString();
        var i = 0;
        while (i < n)
        {
            var k = 0;
            while (k < n)
            {
                var row: String = f"--------";
                if (0 < i < n)
                {
                    if(getColor(i - 1, k) == getColor(i, k))
                        row = f"*       ";
                }
                if(i == 0 or i == n)
                {
                    row = f"----{k}---";
                }

                result.append(&row);
                k += 1;
            }
            result.append("-\n");

            var j = 0;
            while (j < n)
            {
                var row: str = "       ";
                if (occupied.at(i * n + j) == 1)
                    row = "  \\ /  ";

                var color: i32 = getColor(i, j);
                result.append(f"{verticalSeparator(i, j)}{BACK_COLORS[color]}{row}{RESET_COLOR}".asSlice());
                j += 1;
            }
            result.append("|\n");


            j = 0;
            while (j < n)
            {
                # (color + '0' as i8) as char
                var row = "       ";
                var color: i32 = getColor(i, j);
                
                if (not canPlace(i, j))
                {
                    row = "   x   ";
                }
                if (hasQueen(i, j))
                    row = "  -Q-  ";
                
                var separator: String = f"{verticalSeparator(i, j)}";

                # Coordinates on left border
                if (j == 0)
                {
                    separator = f"{i}";
                }

                concat(&result, f"{separator}{BACK_COLORS[color]}{row}{RESET_COLOR}".asSlice());
                j += 1;
            }
            result.append(f"{i}\n");

            j = 0;
            while (j < n)
            {
                var row: str = "       ";
                
                if (occupied.at(i * n + j) == 1)
                    row = "  / \\  ";
                
                if (isNew(i,  j))
                    row = " ##### ";

                var color: i32 = getColor(i, j);
                concat(&result, f"{verticalSeparator(i, j)}{BACK_COLORS[color]}{row}{RESET_COLOR}".asSlice());
                j += 1;
            }
            concat(&result, "|\n");


            j = 0;
            while (j < n)
            {
                refresh(i, j);
                j += 1;
            }

            i += 1;
        }

        i = 0;
        while (i < n)
        {
            concat(&result, "--------");
            i += 1;
        }
        concat(&result, "-\n");
        return result;
    }

}