fun readBoard() -> Solution = {
    var n: i32 = readI64() as i32;
    var boardList: List[i32];

    var x: i32 = 0;
    while (x < n)
    {
        var y: i32 = 0;
        while (y < n)
        {
            var color: i32 = skipBlanks() as i8 - '0' as i8;
            boardList.push(color);
            y += 1;
        }
        # var endl: char = readChar();
        
        x += 1;
    }

    var solution : Solution;
    solution.initialize(
        n,
        &boardList
    );
    return solution;
}

