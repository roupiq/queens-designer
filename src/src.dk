import core.builtins.*;
import constants.*;
import helpers.*;
import puzzles.*;
import queens.*;

var solution_found: Solution;
fun solve(solution: ref Solution, start: i32 = 0) -> bool = {

    if (solution.isSolved()) {
        solution_found = copy solution;
        print(f"Solved\n{solution}\n");

        return true;
    }

    var n = solution.n;
    var i = start;

    while (i < solution.n * solution.n)
    {
        var x: i32 = i / n;
        var y: i32 = i % n;
        
        if (solution.canPlace(x, y))
        {
            var next_solution: Solution = copy solution;

            next_solution.placeQueen(x, y);

            if(solve(&next_solution, i + 1)) 
            {
                print(f"{solution}\n");
                return true;
            }
        }

        i += 1;
    }

    return false;
}

fun main() = {
    var boardList: List[i32] = toList[i32, Puzzles.N2](&Puzzles.board);
    
    var solution : Solution;
    solution.initialize(
        Puzzles.N,
        &boardList
    );

    solve(&solution);
}
