import core.builtins.*;
import constants.*;
import helpers.*;
import queens.*;
import strategies.*;
import random.*;

var solutionFound: Queens;
fun solveRecursive(queens: ref Queens, start: i32 = 0, silent: bool = true, limit: i32 = 100000, solutionsCount: ref i32) -> i32 = {
    if (queens.isSolved()) {
        solutionFound = copy queens;
        queens.refreshAll();
        if (not silent)
            print(f"\nSolution\n{queens}\n");
        solutionsCount += 1;
        return 1;
    }

    var n = queens.n;
    var solutions = 0;
    var i = start;

    while (i < queens.n * queens.n)
    {
        var x: i32 = i / n;
        var y: i32 = i % n;
        
        if (queens.canPlace(x, y))
        {
            var next_queens: Queens = copy queens;

            next_queens.placeQueen(x, y);

            solutions += solveRecursive(&next_queens, i + 1, silent, limit, solutionsCount);
            if (solutionsCount == limit) {
                return solutions;
            }
        }

        i += 1;
    }

    return solutions;
}

fun solve(queens: ref Queens, start: i32 = 0, silent: bool = true, limit: i32 = 100000) -> i32 = {
    var solutionsCount = 0;
    return solveRecursive(queens, start, silent, limit, &solutionsCount)
}

fun solveLikeHuman(solution: ref Queens, verbose: bool = true) -> i32 = {
    var result = 0;
    if (verbose)
    {
        print("\n\n");
        print(f"{solution}");
        print("Attempting to solve using human-like heuristics.\n");
    }
    
    while (not solution.isSolved())
    {
        if(verbose)
        {
            wait(f"Press any key to continue.\n");
        }
            
        # var progres: bool = true;
        if(verbose)
        {
            print("\n");
            print("\n");
            print("\n");
        }

        var strategyName: String;
        if(strategy1(&solution))
        {
            result = max(result, 1);
            strategyName = f"1";
        }
        else if(strategy15(&solution))
        {
            result = max(result, 2);
            strategyName = f"1.5";
        }
        else if(strategy2(&solution))
        {
            result = max(result, 3);
            strategyName = f"2";
        }
        else if(strategy3(&solution))
        {
            result = max(result, 4);
            strategyName = f"3";
        }
        else if(strategy4(&solution))
        {
            result = max(result, 5);
            strategyName = f"4";
        }
        else if(strategy5(&solution))
        {
            result = max(result, 6);
            strategyName = f"5";
        }
        else if(strategy6(&solution))
        {
            result = max(result, 7);
            strategyName = f"6";
        }
        else
        {
            if (verbose) print("All heuristics failed! 😔\n");
            return INF;
        }
        
        if(verbose) {
            print(f"{solution}\n");
            print(f"Using strategy {strategyName}\n");
            print(f"Explanation: {explanation}\n");
        }
    }
    if(verbose) print("GAME SOLVED! 😃\n");

    return result;
}

fun randomQueens(n: i32) -> Queens = {
    var queens : Queens;
    var boardList: List[i32];

    resize(&boardList, n * n, n);

    queens.initialize(n, &boardList);

    var queensPositionsX: List[i32];
    var queensPositionsY: List[i32];
    
    var i = 0;
    while (i < n) {
        queensPositionsX.push(i);
        queensPositionsY.push(i);
        i += 1;
    }

    shuffle[i32](&queensPositionsX);
    shuffle[i32](&queensPositionsY);

    i = 0;
    while (i < n) {
        var x = queensPositionsX.at(i);
        var y = queensPositionsY.at(i);
        queens.setColor(x, y, i);
        i += 1;
    }

    # print(f"{queensPositionsX}\n");
    # print(f"{queensPositionsY}\n");

    var colored = n;
        
    while(colored < n * n)
    {
        var x = random() % n;
        var y = random() % n;

        if (queens.getColor(x, y) == n)
        {

            var dir = random() % 4;

            var sourceX = x + [-1, 1, 0, 0][dir];
            var sourceY = y + [0, 0, -1, 1][dir];

            if(0 <= sourceX < n and 0 <= sourceY < n)
            {
                var sourceColor = queens.getColor(sourceX, sourceY);
                if (sourceColor != n)
                {
                    queens.setColor(x, y, sourceColor);
                    colored += 1;
                }
            }
        }
    }
    
    # print(f"{queens}");
    return queens;
}

fun randomSolvableQueens(n: i32) -> Queens = {
    print(f"Generating random solvable queens\n");
    
    var queens: Queens;
    while (true)
    {
        queens = randomQueens(n);
        var solutionsCount = solve(&queens, 0, true, 2);
        if (solutionsCount == 1)
            return queens;
    }
    return queens;
}

fun randomHardSolvableQueens(n: i32, minLevel: i32 = 7, maxLevel: i32 = INF) -> Queens = {
    print(f"Generating random hard solvable queens\n");
    
    var queens: Queens;
    while (true)
    {
        queens = randomSolvableQueens(n);
        var queensCopy = copy queens;
        
        if(minLevel <= solveLikeHuman(&queensCopy, false) <= maxLevel)
        {
            return queens;
        }
    }
    return queens;
}

fun readBoard() -> Queens = {
    print(f"Paste your puzzle here.\n");

    var n: i32 = readI64() as i32;
    var boardList: List[i32];
    
    var x: i32 = 0;
    while (x < n)
    {
        var y: i32 = 0;
        while (y < n)
        {
            var color: i32 = skipBlanks() as i8 - '0' as i8;

            if (color >= n) {
                print(f"Color {color} out of range [0, {n - 1}]")
            }

            boardList.push(color);
            y += 1;
        }
        
        x += 1;
    }

    var queens : Queens;
    queens.initialize(
        n,
        &boardList
    );
    return queens;
}

fun main() = {
    # Clear screen
    print("[2J\n");
    print(f"{BRIGHT_STYLE} .oOOOo.                                         o      O        o                   \n");
    print(f"{BRIGHT_STYLE}.O     o.                                        O      o       O                    \n");
    print(f"{BRIGHT_STYLE}o       O                                        o      O       o                    \n");
    print(f"{BRIGHT_STYLE}O       o                                        OoOooOOo       O                    \n");
    print(f"{BRIGHT_STYLE}o       O  O   o  .oOo. .oOo. 'OoOo. .oOo        o      O .oOo. o  .oOo. .oOo. `OoOo.\n");
    print(f"{BRIGHT_STYLE}O    Oo o  o   O  OooO' OooO'  o   O `Ooo.       O      o OooO' O  O   o OooO'  o    \n");
    print(f"{BRIGHT_STYLE}`o     O'  O   o  O     O      O   o     O       o      o O     o  o   O O      O    \n");
    print(f"{BRIGHT_STYLE} `OoooO Oo `OoO'o `OoO' `OoO'  o   O `OoO'       o      O `OoO' Oo oOoO' `OoO'  o    \n");
    print(f"{BRIGHT_STYLE}                                                                   O                 \n");
    print(f"{BRIGHT_STYLE}                                                                   o'                \n");


    var queens: Queens;
    print("Select option: \n");
    print(" 1. Generate a random puzzle\n");
    print(" 2. Solve an existing puzzle\n");
    print("> ");
    var option = readI64();

    if(option == 1) {
            print("Enter seed\n");
            setSeed(readI64() as u64);
            print("Enter size\n");
            var n = readI64() as i32;
            queens = randomHardSolvableQueens(n, 7, 7);
    }
    else if (option == 2)
    {
        print("Enter puzzle\n");
        queens = readBoard();
    }

    var solutions_count: i32 = solve(&queens);
    if (solutions_count == 0)
    {
        print(f"There is no solution to this puzzle 😔. Trying to solve anyway.\n");
    }
    if (solutions_count == 1)
    {
        print(f"There is exactly one solution to this puzzle 😃.\n");
    }
    if (solutions_count > 1)
    {
        print(f"There are {solutions_count} solutions to this puzzle 😔.\n");
    }

    wait(f"Press any key to start solving");
    solveLikeHuman(&queens);
}
