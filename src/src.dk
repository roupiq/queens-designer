import core.builtins.*;
import constants.*;
import helpers.*;
import puzzles.*;
import queens.*;
import strategies.*;

var solution_found: Solution;
fun solve(solution: ref Solution, start: i32 = 0) -> i32 = {
    if (solution.isSolved()) {
        solution_found = copy solution;
        solution.refreshAll();
        print(f"\nSolution\n{solution}\n");
        return 1;
    }

    var n = solution.n;
    var solutions = 0;
    var i = start;

    while (i < solution.n * solution.n)
    {
        var x: i32 = i / n;
        var y: i32 = i % n;
        
        if (solution.canPlace(x, y))
        {
            var next_solution: Solution = copy solution;

            next_solution.placeQueen(x, y);

            solutions += solve(&next_solution, i + 1);
        }

        i += 1;
    }

    return solutions;
}

fun solveLikeHuman(solution: ref Solution) = {
    
    print("\n\n");
    print(f"{solution}");
    print("Attempting to solve using human-like heuristics.\n");
    
    while (not solution.isSolved())
    {
        print("Press any key to continue.\n");
        
        var ignore: char = builtin_input_char();
    
        # var progres: bool = true;
        print("\n");
        print("\n");
        print("\n");

        if(apply1(&solution))
        {
            print(f"{solution}");
            print(" -- Applied strategy 1 -- \n");
            print(f"{message}");
            continue;
        }

        if(apply15(&solution))
        {
            print(f"{solution}");
            print(" -- Applied strategy 1.5 -- \n");
            print(f"{message}");
            continue;
        }

        if(apply2(&solution))
        {
            print(f"{solution}");
            print(" -- Applied strategy 2 -- \n");
            print(f"{message}");
            continue;
        }
        
        
        if(apply3(&solution))
        {
            print(" -- Applied strategy 3 -- \n");
            print(f"{solution}");
            print(f"{message}");
            continue;
        }

        if(apply4(&solution))
        {
            print(f"{solution}");
            print(" -- Applied strategy 4 -- \n");
            print(f"{message}");
            continue;
        }
        
        print("All heuristics failed! 😔\n");
        return;
    }
    print("GAME SOLVED! 😃\n");
}

