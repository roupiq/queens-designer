import core.builtins.*;
import src.constants.*;
import src.helpers.*;
import src.puzzles.*;
import src.queens.*;

fun min(a: i32, b: i32) -> i32 = {
    return if a < b then a else b;
}

fun max(a: i32, b: i32) -> i32 = {
    return if a > b then a else b;
}

## min_x, max_x, min_y, max_y
fun getColorRange(solution: ref Solution, color: i32) -> i32[4] = {
    var result: i32[4] = [INF, -1, INF, -1];
    var x = 0;

    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
            {
                result[0] = min(x, result[0]);
                result[1] = max(x, result[1]);
                result[2] = min(y, result[2]);
                result[3] = max(y, result[3]);
            }
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun getColorCount(solution: ref Solution, color: i32) -> i32 = {
    var result: i32 = 0;
    var x = 0;
    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
                result += 1;
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun findFreeColor(solution: ref Solution, color: i32) -> i32[2] = {
    var x = 0;
    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
                return [x, y];
            y += 1;
        }

        x += 1;
    }
    return [-1, -1];
}

fun areColorsValid(solution: ref Solution) -> bool = {
    var color: i32 = 0;
    while(color < solution.n)
    {
        if (solution.occupiedColors.at(color) == 0 and getColorCount(&solution, color) == 0)
        {
            return false;
        }
        color += 1;
    }
    return true;
}

fun apply1(solution: ref Solution) -> bool = {
    var i = 0;

    # Checking each color
    while (i < solution.n)
    {
        var freeColorI: i32 = getColorCount(&solution, i);
        if(freeColorI == 1)
        {
            var pos = findFreeColor(&solution, i);
            solution.placeQueen(pos[0], pos[1]);
            return true;
        }
        i += 1;
    }
    return false;
}

fun apply2(solution: ref Solution) -> bool = {
    var i = 0;

    # Checking each color
    while (i < solution.n)
    {
        var range = getColorRange(&solution, i);
        var anything_changed: bool = false;
        # every tile of this color is on the same x coordinate
        if (range[0] == range[1])
        {
            var x = range[0];
            var y = 0;
            while (y < solution.n)
            {
                if(solution.getColor(x, y) != i and solution.canPlace(x, y))
                {
                    anything_changed = true;
                    solution.placeCross(x, y);
                }
                y += 1;
            }
            if(anything_changed)
            {
                print(f"{range}");
                # print(f"{range[0]}, {range[1]}, {range[2]}, {range[3]}");
                print(f"Color {COLOR_NAMES[i]} has every tile on the same width {x}\n");
                return true;
            }
        }

        # every tile of this color is on the same y coordinate
        if (range[2] == range[3])
        {
            var x = 0;
            var y = range[2];
            while (x < solution.n)
            {
                if(solution.getColor(x, y) != i and solution.canPlace(x, y))
                {
                    anything_changed = true;
                    solution.placeCross(x, y);
                }
                x += 1;
            }
            if(anything_changed)
            {
                print(f"Color {COLOR_NAMES[i]} has every tile on the same height {y}\n");
                return true;
            }
        }

        i += 1;
    }
    return false;
}

fun apply3(solution: ref Solution) -> bool = {
    # For each cell placing queen and checking if it does break.
    var x = 0;

    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n) {
            if(solution.canPlace(x, y))
            {
                var next_solution: Solution = copy solution;
                next_solution.placeQueen(x, y);
                if (not areColorsValid(&next_solution))
                {
                    solution.placeCross(x, y);
                    print(f"Queen at position {x}, {y} bloks other colors entierly\n");
                    return true;
                }
            }
            y += 1;
        }
        x += 1;
    }
    return false;
}

fun rowsSegmentsStrategy(solution: ref Solution, x1: i32, x2: i32) -> bool = {
    var x = x1;
    var colors: List[i32];
    
    resize(&colors, solution.n);
    var anything_changed: bool = false;

    var fillableCollumns = 0;

    while(x < x2)
    {
        if(not (solution.rowHasQueen(x))) fillableCollumns += 1;

        var y = 0;
        while (y < solution.n)
        {
            if (solution.canPlace(x, y))
            {
                colors.at(solution.getColor(x, y)) = 1;
            }
            y += 1;
        }

        x += 1;
    }

    # Print colors
    print(f"[{x1}, {x2}), {colors} {fillableCollumns}\n");

    if (sum[i32](&colors) == fillableCollumns)
    {
        x = 0;
        while (x < x1)
        {
            var y = 0;
            while (y < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

        x = x2;
        while (x < solution.n)
        {
            var y = 0;
            while (y < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

    }

    return anything_changed;
}

fun columnsSegmentsStrategy(solution: ref Solution, y1: i32, y2: i32) -> bool = {
    var y = y1;
    var colors: List[i32];
    
    resize(&colors, solution.n);
    var anything_changed: bool = false;

    var fillableCollumns = 0;

    while(y < y2)
    {
        if(not solution.columnHasQueen(y)) fillableCollumns += 1;

        var x = 0;
        while (x < solution.n)
        {
            if (solution.canPlace(x, y))
            {
                colors.at(solution.getColor(x, y)) = 1;
            }
            x += 1;
        }

        y += 1;
    }

    # Print colors
    # print(f"[{x1}, {x2}), {colors} {fillableCollumns}\n");

    if (sum[i32](&colors) == fillableCollumns)
    {
        y = 0;
        while (y < y1)
        {
            var x = 0;
            while (x < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }

        y = y2;
        while (y < solution.n)
        {
            var x = 0;
            while (x < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }
    }

    return anything_changed;
}


fun apply4(solution: ref Solution) -> bool = {
    var i = 1;
    var n = solution.n;
    while (i <= n)
    {
        if(rowsSegmentsStrategy(&solution, n - i, n))
        {
            print(f"There are exactly {i} placable colors on rows {n - i}-{n - 1}\n");
            return true;
        }

        if(rowsSegmentsStrategy(&solution, 0, i))
        {
            print(f"There are exactly {i} placable colors on rows {0}-{i - 1}\n");
            return true;
        }

        if(columnsSegmentsStrategy(&solution, n - i, n))
        {
            print(f"There are exactly {i} placable colors on columns {n - i}-{n - 1}\n");
            return true;
        }

        if(columnsSegmentsStrategy(&solution, 0, i))
        {
            print(f"There are exactly {i} placable colors on columns {0}-{i - 1}\n");
            return true;
        }

        i += 1;
    }
    return false;
}


fun apply5(solution: ref Solution) -> bool = {
    var i = 1;
    var n = solution.n;
    while (i <= n)
    {
        var j = 0;
        while (j + i <= n)
        {
            if(rowsSegmentsStrategy(&solution, j, i + j))
            {
                print(f"There are exactly {i} placable colors on rows {j}-{j + i - 1}\n");
                return true;
            }

            if(columnsSegmentsStrategy(&solution, j, i + j))
            {
                print(f"There are exactly {i} placable colors on columns {j}-{j + i - 1}\n");
                return true;
            }
            i += 1;
        }

        i += 1;
    }
    return false;
}


