import core.builtins.*;
import src.constants.*;
import src.helpers.*;
import src.queens.*;

fun coords(x: i32, y: i32) -> String = {
    return f"{ALPHABET[x]}{y}";
}

## min_x, max_x, min_y, max_y
fun getColorRange(solution: ref Solution, color: i32) -> i32[4] = {
    var result: i32[4] = [INF, -1, INF, -1];
    var x = 0;

    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
            {
                result[0] = min(x, result[0]);
                result[1] = max(x, result[1]);
                result[2] = min(y, result[2]);
                result[3] = max(y, result[3]);
            }
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun getColorCount(solution: ref Solution, color: i32) -> i32 = {
    var result: i32 = 0;
    var x = 0;
    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
                result += 1;
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun findFreeColor(solution: ref Solution, color: i32) -> i32[3] = {
    var x = 0;
    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n)
        {
            if (solution.getColor(x, y) == color and solution.canPlace(x, y))
                return [x, y, color];
            y += 1;
        }

        x += 1;
    }
    return [-1, -1, -1];
}

fun areColorsValid(solution: ref Solution) -> i32 = {
    var color: i32 = 0;
    while(color < solution.n)
    {
        if (solution.occupiedColors.at(color) == 0 and getColorCount(&solution, color) == 0)
        {
            return color;
        }
        color += 1;
    }
    return -1;
}

var explanation: String;

fun strategy1(solution: ref Solution) -> bool = {
    var i = 0;

    # Checking each color
    while (i < solution.n)
    {
        var freeColorI: i32 = getColorCount(&solution, i);
        if(freeColorI == 1)
        {
            var pos = findFreeColor(&solution, i);
            explanation = f"Placing queen at {coords(pos[0], pos[1])} because thats the only free {COLOR_NAMES[pos[2]]} tile.\n";
            solution.placeQueen(pos[0], pos[1]);
            return true;
        }
        i += 1;
    }
    return false;
}


# Checks if there are some rows (or columns) that have only one placable tile
fun strategy15(solution: ref Solution) -> bool = {
    if (singleOneInColumn(&solution))
        return true;
    if (singleOneInRow(&solution))
        return true;
    return false;
}

fun strategy2(solution: ref Solution) -> bool = {
    var i = 0;

    # Checking each color
    while (i < solution.n)
    {
        var range = getColorRange(&solution, i);
        var anything_changed: bool = false;
        # every tile of this color is on the same x coordinate
        if (range[0] == range[1])
        {
            var x = range[0];
            var y = 0;
            while (y < solution.n)
            {
                if(solution.getColor(x, y) != i and solution.canPlace(x, y))
                {
                    anything_changed = true;
                    solution.placeCross(x, y);
                }
                y += 1;
            }
            if(anything_changed)
            {
                # print(f"{range[0]}, {range[1]}, {range[2]}, {range[3]}");
                explanation = f"Color {COLOR_NAMES[i]} has every free tile on the row {ALPHABET[x]}.\n";
                return true;
            }
        }

        # every tile of this color is on the same y coordinate
        if (range[2] == range[3])
        {
            var x = 0;
            var y = range[2];
            while (x < solution.n)
            {
                if(solution.getColor(x, y) != i and solution.canPlace(x, y))
                {
                    anything_changed = true;
                    solution.placeCross(x, y);
                }
                x += 1;
            }
            if(anything_changed)
            {
                explanation = f"Color {COLOR_NAMES[i]} has every free tile on the column {y}.\n";
                return true;
            }
        }

        i += 1;
    }
    return false;
}

fun singleOneInColumn(solution: ref Solution) -> bool = {
    var x = 0;
    while (x < solution.n)
    {
        var pos: i32[2] = [-1, -1];

        var y = 0;
        while (y < solution.n) {
            if (solution.canPlace(x, y))
            {
                if (pos[0] == -1)
                {
                    pos = [x, y];
                }
                else
                {
                    pos = [-1, -1];
                    break;
                }
            }
            y += 1;
        }

        if (pos[0] != -1)
        {
            solution.placeQueen(pos[0], pos[1]);
            explanation = f"Tile {coords(pos[0], pos[1])} is the only free one at this column";
            return true;
        }

        x += 1;
    }
    return false;
}

fun singleOneInRow(solution: ref Solution) -> bool = {
    var y = 0;
    while (y < solution.n)
    {
        var pos: i32[2] = [-1, -1];

        var x: i32 = 0;
        while (x < solution.n) {
            if (solution.canPlace(x, y))
            {
                if (pos[0] == -1)
                {
                    pos = [x, y];
                }
                else
                {
                    pos = [-1, -1];
                    break;
                }
            }
            x += 1;
        }

        if (pos[0] != -1)
        {
            solution.placeQueen(pos[0], pos[1]);
            explanation = f"Tile {coords(pos[0], pos[1])} is the only free one at this row.\n";
            return true;
        }

        y += 1;
    }
    return false;
}


fun strategy3(solution: ref Solution) -> bool = {
    # For each tile placing queen and checking if it does break.

    var x = 0;
    while (x < solution.n)
    {
        var y = 0;
        while (y < solution.n) {
            if(solution.canPlace(x, y))
            {
                var next_solution: Solution = copy solution;
                next_solution.placeQueen(x, y);

                var blocked_color: i32 = areColorsValid(&next_solution);
                if (blocked_color != -1)
                {
                    solution.placeCross(x, y);
                    explanation = f"Queen at position {coords(x, y)} blocks all {COLOR_NAMES[blocked_color]} tiles.\n";
                    return true;
                }
            }
            y += 1;
        }
        x += 1;
    }
    return false;
}

fun rowsSegmentsStrategy(solution: ref Solution, x1: i32, x2: i32) -> bool = {
    var x = x1;
    var colors: List[i32];
    
    resize(&colors, solution.n);
    var anything_changed: bool = false;

    var fillableRows = 0;

    while(x < x2)
    {
        if(not (solution.rowHasQueen(x))) fillableRows += 1;

        var y = 0;
        while (y < solution.n)
        {
            if (solution.canPlace(x, y))
            {
                colors.at(solution.getColor(x, y)) = 1;
            }
            y += 1;
        }

        x += 1;
    }

    # Print colors
    # print(f"[{x1}, {x2}), {colors} {fillableRows}\n");

    if (sum[i32](&colors) == fillableRows)
    {
        x = 0;
        while (x < x1)
        {
            var y = 0;
            while (y < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

        x = x2;
        while (x < solution.n)
        {
            var y = 0;
            while (y < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

    }

    return anything_changed;
}

fun columnsSegmentsStrategy(solution: ref Solution, y1: i32, y2: i32) -> bool = {
    var y = y1;
    var colors: List[i32];
    
    resize(&colors, solution.n);
    var anything_changed: bool = false;

    var fillableColumns = 0;

    while(y < y2)
    {
        if(not solution.columnHasQueen(y)) fillableColumns += 1;

        var x = 0;
        while (x < solution.n)
        {
            if (solution.canPlace(x, y))
            {
                colors.at(solution.getColor(x, y)) = 1;
            }
            x += 1;
        }

        y += 1;
    }

    # Print colors
    # print(f"[{x1}, {x2}), {colors} {fillableColumns}\n");

    if (sum[i32](&colors) == fillableColumns)
    {
        y = 0;
        while (y < y1)
        {
            var x = 0;
            while (x < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }

        y = y2;
        while (y < solution.n)
        {
            var x = 0;
            while (x < solution.n)
            {
                if (solution.canPlace(x, y) and colors.at(solution.getColor(x, y)) == 1)
                {
                    solution.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }
    }

    return anything_changed;
}


fun strategy4(solution: ref Solution) -> bool = {
    var i = 1;
    var n = solution.n;

    while (i <= n)
    {
        if(rowsSegmentsStrategy(&solution, n - i, n))
        {   
            explanation = f"There are exactly {i} placable colors on rows {ALPHABET[n - i]}-{ALPHABET[n - 1]}\n";
            return true;
        }

        if(rowsSegmentsStrategy(&solution, 0, i))
        {
            explanation = f"There are exactly {i} free colors on rows {ALPHABET[0]}-{ALPHABET[i - 1]}\n";
            return true;
        }

        if(columnsSegmentsStrategy(&solution, n - i, n))
        {
            explanation = f"There are exactly {i} free colors on columns {n - i}-{n - 1}\n";
            return true;
        }

        if(columnsSegmentsStrategy(&solution, 0, i))
        {
            explanation = f"There are exactly {i} free colors on columns {0}-{i - 1}\n";
            return true;
        }

        i += 1;
    }
    return false;
}


fun strategy5(solution: ref Solution) -> bool = {
    var i = 1;
    var n = solution.n;
    while (i <= n)
    {
        var j = 0;
        while (j + i <= n)
        {
            if(rowsSegmentsStrategy(&solution, j, i + j))
            {
                explanation = f"The number of free colors is equal to the number of free rows from {ALPHABET[j]}-{ALPHABET[j + i - 1]}\n";
                return true;
            }

            if(columnsSegmentsStrategy(&solution, j, i + j))
            {
                explanation = f"Same number of free colors as number of free columns from {j}-{j + i - 1}\n";
                return true;
            }
            i += 1;
        }

        i += 1;
    }
    return false;
}