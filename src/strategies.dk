import core.builtins.*;
import src.constants.*;
import src.helpers.*;
import src.queens.*;

fun coords(x: i32, y: i32) -> String = {
    return f"{ALPHABET[x]}{y}";
}

## min_x, max_x, min_y, max_y
fun getColorRange(queens: ref Queens, color: i32) -> i32[4] = {
    var result: i32[4] = [INF, -1, INF, -1];
    var x = 0;

    while (x < queens.n)
    {
        var y = 0;
        while (y < queens.n)
        {
            if (queens.getColor(x, y) == color and queens.canPlace(x, y))
            {
                result[0] = min(x, result[0]);
                result[1] = max(x, result[1]);
                result[2] = min(y, result[2]);
                result[3] = max(y, result[3]);
            }
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun getColorCount(queens: ref Queens, color: i32) -> i32 = {
    var result: i32 = 0;
    var x = 0;
    while (x < queens.n)
    {
        var y = 0;
        while (y < queens.n)
        {
            if (queens.getColor(x, y) == color and queens.canPlace(x, y))
                result += 1;
            y += 1;
        }

        x += 1;
    }
    return result;
}

fun findFreeColor(queens: ref Queens, color: i32) -> i32[3] = {
    var x = 0;
    while (x < queens.n)
    {
        var y = 0;
        while (y < queens.n)
        {
            if (queens.getColor(x, y) == color and queens.canPlace(x, y))
                return [x, y, color];
            y += 1;
        }

        x += 1;
    }
    return [-1, -1, -1];
}

fun areColorsValid(queens: ref Queens) -> i32 = {
    var color: i32 = 0;
    while(color < queens.n)
    {
        if (queens.occupiedColors.at(color) == 0 and getColorCount(&queens, color) == 0)
        {
            return color;
        }
        color += 1;
    }
    return -1;
}

var explanation: String;

fun strategy1(queens: ref Queens) -> bool = {
    var i = 0;

    # Checking each color
    while (i < queens.n)
    {
        var freeColorI: i32 = getColorCount(&queens, i);
        if(freeColorI == 1)
        {
            var pos = findFreeColor(&queens, i);
            explanation = f"Placing queen at {coords(pos[0], pos[1])} because it is the only free {COLOR_NAMES[pos[2]]} tile.\n";
            queens.placeQueen(pos[0], pos[1]);
            return true;
        }
        i += 1;
    }
    return false;
}


# Checks if there are some rows (or columns) that have only one placable tile
fun strategy2(queens: ref Queens) -> bool = {
    if (singleOneInColumn(&queens))
        return true;
    if (singleOneInRow(&queens))
        return true;
    return false;
}

fun strategy3(queens: ref Queens) -> bool = {
    var i = 0;

    # Checking each color
    while (i < queens.n)
    {
        var range = getColorRange(&queens, i);
        var anything_changed: bool = false;
        # every tile of this color is on the same x coordinate
        if (range[0] == range[1])
        {
            var x = range[0];
            var y = 0;
            while (y < queens.n)
            {
                if(queens.getColor(x, y) != i and queens.canPlace(x, y))
                {
                    anything_changed = true;
                    queens.placeCross(x, y);
                }
                y += 1;
            }
            if(anything_changed)
            {
                # print(f"{range[0]}, {range[1]}, {range[2]}, {range[3]}");
                explanation = f"Every free {COLOR_NAMES[i]} tile is in row {ALPHABET[x]}.\n";
                return true;
            }
        }

        # every tile of this color is on the same y coordinate
        if (range[2] == range[3])
        {
            var x = 0;
            var y = range[2];
            while (x < queens.n)
            {
                if(queens.getColor(x, y) != i and queens.canPlace(x, y))
                {
                    anything_changed = true;
                    queens.placeCross(x, y);
                }
                x += 1;
            }
            if(anything_changed)
            {
                explanation = f"Every free {COLOR_NAMES[i]} tile is in column {y}.\n";
                return true;
            }
        }

        i += 1;
    }
    return false;
}

fun singleOneInColumn(queens: ref Queens) -> bool = {
    var x = 0;
    while (x < queens.n)
    {
        var pos: i32[2] = [-1, -1];

        var y = 0;
        while (y < queens.n) {
            if (queens.canPlace(x, y))
            {
                if (pos[0] == -1)
                {
                    pos = [x, y];
                }
                else
                {
                    pos = [-1, -1];
                    break;
                }
            }
            y += 1;
        }

        if (pos[0] != -1)
        {
            queens.placeQueen(pos[0], pos[1]);
            explanation = f"Tile {coords(pos[0], pos[1])} is the only free one at this column";
            return true;
        }

        x += 1;
    }
    return false;
}

fun singleOneInRow(queens: ref Queens) -> bool = {
    var y = 0;
    while (y < queens.n)
    {
        var pos: i32[2] = [-1, -1];

        var x: i32 = 0;
        while (x < queens.n) {
            if (queens.canPlace(x, y))
            {
                if (pos[0] == -1)
                {
                    pos = [x, y];
                }
                else
                {
                    pos = [-1, -1];
                    break;
                }
            }
            x += 1;
        }

        if (pos[0] != -1)
        {
            queens.placeQueen(pos[0], pos[1]);
            explanation = f"Tile {coords(pos[0], pos[1])} is the only free one at this row.\n";
            return true;
        }

        y += 1;
    }
    return false;
}


fun strategy4(queens: ref Queens) -> bool = {
    # For each tile placing queen and checking if it does break.

    var x = 0;
    while (x < queens.n)
    {
        var y = 0;
        while (y < queens.n) {
            if(queens.canPlace(x, y))
            {
                var next_solution: Queens = copy queens;
                next_solution.placeQueen(x, y);

                var blocked_color: i32 = areColorsValid(&next_solution);
                if (blocked_color != -1)
                {
                    queens.placeCross(x, y);
                    explanation = f"Queen on {coords(x, y)} would block all free {COLOR_NAMES[blocked_color]} tiles.\n";
                    return true;
                }
            }
            y += 1;
        }
        x += 1;
    }
    return false;
}

fun rowsSegmentsStrategy(queens: ref Queens, x1: i32, x2: i32) -> bool = {
    var x = x1;
    var colors: List[i32];
    
    resize(&colors, queens.n);
    var anything_changed: bool = false;

    var fillableRows = 0;

    while(x < x2)
    {
        if(not (queens.rowHasQueen(x))) fillableRows += 1;

        var y = 0;
        while (y < queens.n)
        {
            if (queens.canPlace(x, y))
            {
                colors.at(queens.getColor(x, y)) = 1;
            }
            y += 1;
        }

        x += 1;
    }

    if (sum[i32](&colors) == fillableRows)
    {
        x = 0;
        while (x < x1)
        {
            var y = 0;
            while (y < queens.n)
            {
                if (queens.canPlace(x, y) and colors.at(queens.getColor(x, y)) == 1)
                {
                    queens.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

        x = x2;
        while (x < queens.n)
        {
            var y = 0;
            while (y < queens.n)
            {
                if (queens.canPlace(x, y) and colors.at(queens.getColor(x, y)) == 1)
                {
                    queens.placeCross(x, y);
                    anything_changed = true;
                }
                y += 1;
            }
            x += 1;
        }

    }

    return anything_changed;
}

fun columnsSegmentsStrategy(queens: ref Queens, y1: i32, y2: i32) -> bool = {
    var y = y1;
    var colors: List[i32];
    
    resize(&colors, queens.n);
    var anything_changed: bool = false;

    var fillableColumns = 0;

    while(y < y2)
    {
        if(not queens.columnHasQueen(y)) fillableColumns += 1;

        var x = 0;
        while (x < queens.n)
        {
            if (queens.canPlace(x, y))
            {
                colors.at(queens.getColor(x, y)) = 1;
            }
            x += 1;
        }

        y += 1;
    }
    
    if (sum[i32](&colors) == fillableColumns)
    {
        y = 0;
        while (y < y1)
        {
            var x = 0;
            while (x < queens.n)
            {
                if (queens.canPlace(x, y) and colors.at(queens.getColor(x, y)) == 1)
                {
                    queens.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }

        y = y2;
        while (y < queens.n)
        {
            var x = 0;
            while (x < queens.n)
            {
                if (queens.canPlace(x, y) and colors.at(queens.getColor(x, y)) == 1)
                {
                    queens.placeCross(x, y);
                    anything_changed = true;
                }
                x += 1;
            }
            y += 1;
        }
    }

    return anything_changed;
}


fun strategy5(queens: ref Queens) -> bool = {
    var i = 1;
    var n = queens.n;

    while (i <= n)
    {
        if(rowsSegmentsStrategy(&queens, n - i, n))
        {   
            explanation = f"There are exactly {i} free colors on rows {ALPHABET[n - i]}-{ALPHABET[n - 1]}\n";
            return true;
        }

        if(rowsSegmentsStrategy(&queens, 0, i))
        {
            explanation = f"There are exactly {i} free colors on rows {ALPHABET[0]}-{ALPHABET[i - 1]}\n";
            return true;
        }

        if(columnsSegmentsStrategy(&queens, n - i, n))
        {
            explanation = f"There are exactly {i} free colors on columns {n - i}-{n - 1}\n";
            return true;
        }

        if(columnsSegmentsStrategy(&queens, 0, i))
        {
            explanation = f"There are exactly {i} free colors on columns {0}-{i - 1}\n";
            return true;
        }

        i += 1;
    }
    return false;
}


fun strategy6(queens: ref Queens) -> bool = {
    var i = 1;
    var n = queens.n;
    while (i <= n)
    {
        var j = 0;
        while (j + i <= n)
        {
            if(rowsSegmentsStrategy(&queens, j, i + j))
            {
                explanation = f"There are exactly {i} free colors on rows {ALPHABET[j]}-{ALPHABET[j + i - 1]}\n";
                return true;
            }

            if(columnsSegmentsStrategy(&queens, j, i + j))
            {
                explanation = f"There are exactly {i} free colors on columns {j}-{j + i - 1}\n";
                return true;
            }
            j += 1;
        }

        i += 1;
    }
    return false;
}

fun areThereRowsWithAllCrosses(queens: ref Queens) -> bool = {
    var x = 1;
    var n = queens.n;
    while (x < n)
    {
        if(not queens.rowHasQueen(x))
        {
            var crosses = queens.placableInRow(x);
            if(crosses == n)
                return true;
        }

        x += 1;
    }
    return false;
}

fun areThereColumnsWithAllCrosses(queens: ref Queens) -> bool = {
    var y = 1;
    var n = queens.n;
    while (y < n)
    {
        if(not queens.columnHasQueen(y))
        {
            # print(f"column {y} does not have queen\n");
            var crosses = queens.placableInColumn(y);
            # print(f"crosses: {crosses}\n");
            # print(f"crosses row: {queens.placableInColumn(y)}\n");
            if(crosses == n)
                return true;
        }

        y += 1;
    }
    return false;
}


fun strategy7(queens: ref Queens) -> bool = {
    var i = 1;
    var n = queens.n;
    while (i < n)
    {
        var j = 0;
        while (j < n)
        {
            if (queens.canPlace(i, j))
            {
                var queensCopy = copy queens;
                queensCopy.placeQueen(i, j);

                if(areThereRowsWithAllCrosses(&queensCopy))
                {
                    queens.placeCross(i, j);
                    explanation = f"Queen at {coords(i, j)} would block whole other row.";
                    return true;
                }

                if(areThereColumnsWithAllCrosses(&queensCopy))
                {
                    queens.placeCross(i, j);
                    explanation = f"Queen at {coords(i, j)} would block whole other column.";
                    return true;
                }
            }
            j += 1;
        }

        i += 1;
    }
    return false;
}

fun isSolvableHeuristic(queens: ref Queens) -> bool = {
    var i = 1;
    var n = queens.n;
    while (i < n)
    {
        var j = 0;
        while (j < n)
        {
            if(areThereRowsWithAllCrosses(&queens))
            {
                return false;
            }

            if(areThereColumnsWithAllCrosses(&queens))
            {
                return false;
            }
            j += 1;
        }

        i += 1;
    }
    return true;
}